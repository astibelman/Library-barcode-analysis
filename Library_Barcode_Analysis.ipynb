import os
from collections import Counter
import pandas as pd
import matplotlib.pyplot as plt
from scipy.stats import linregress

# ================================
# SETTINGS
# ================================
base_folder = r"C:\Users\astib\Desktop\Experiments\barcode"
library_folders = ["b6_R1", "b7_R1", "b9v2_R1"]  # <-- add more if needed

fixed_sequence = "GGGCCAGGGCCGTTG"
barcode_length = 10
max_mismatches = 1
min_donor_count = 2
min_recipient_count = 1

donor_identifier = "donor"
recipient_droplet_identifier = "droplet"
recipient_plate_identifier = "plate"

donor_contam_seq = "CGGTGCTCTATCCCCTGAGC"
recipient_contam_seq = "AACGTAAAGCGATCATGAGC"

# ================================
# HELPER FUNCTIONS
# ================================
def count_mismatches(seq1, seq2):
    return sum(1 for a, b in zip(seq1, seq2) if a != b)

def extract_barcodes_fastq(file_path, fixed_sequence, barcode_length=10, max_mismatches=1,
                           donor_contam=None, recipient_contam=None, mode="donor"):
    barcode_counts = Counter()
    contaminated_reads = []

    with open(file_path, 'r') as f:
        for i, line in enumerate(f):
            if i % 4 == 1:
                seq = line.strip().upper()
                if (mode == "donor" and donor_contam in seq) or (mode != "donor" and recipient_contam in seq):
                    contaminated_reads.append(seq)
                    continue
                for j in range(len(seq) - len(fixed_sequence) - barcode_length + 1):
                    window = seq[j:j + len(fixed_sequence)]
                    if count_mismatches(window, fixed_sequence) <= max_mismatches:
                        barcode = seq[j + len(fixed_sequence): j + len(fixed_sequence) + barcode_length]
                        barcode_counts[barcode] += 1
                        break
    return barcode_counts, contaminated_reads

def compute_r2(x, y):
    valid = (x > 0) & (y > 0)
    if valid.sum() > 2:
        slope, intercept, r_value, p_value, std_err = linregress(x[valid], y[valid])
        return r_value ** 2
    return 0

# ================================
# PROCESS EACH LIBRARY
# ================================
summary_data = []

for i, lib in enumerate(library_folders, start=1):
    data_folder = os.path.join(base_folder, lib)
    print(f"\n=== Processing {lib} ===")

    donor_file = recipient_droplet_file = recipient_plate_file = None
    for f in os.listdir(data_folder):
        if f.endswith(".fastq"):
            f_lower = f.lower()
            if donor_identifier in f_lower:
                donor_file = os.path.join(data_folder, f)
            elif recipient_droplet_identifier in f_lower:
                recipient_droplet_file = os.path.join(data_folder, f)
            elif recipient_plate_identifier in f_lower:
                recipient_plate_file = os.path.join(data_folder, f)
    if not (donor_file and recipient_droplet_file and recipient_plate_file):
        print(f"⚠ Missing FASTQ files for {lib}. Skipping.")
        continue

    # Extract barcodes
    donor_counts_raw, donor_contam_reads = extract_barcodes_fastq(donor_file, fixed_sequence, barcode_length,
                                                                  max_mismatches, donor_contam_seq, recipient_contam_seq, "donor")
    rec_droplet_counts_raw, droplet_contam_reads = extract_barcodes_fastq(recipient_droplet_file, fixed_sequence, barcode_length,
                                                                          max_mismatches, donor_contam_seq, recipient_contam_seq, "recipient")
    rec_plate_counts_raw, plate_contam_reads = extract_barcodes_fastq(recipient_plate_file, fixed_sequence, barcode_length,
                                                                      max_mismatches, donor_contam_seq, recipient_contam_seq, "recipient")

    # Filter low-count barcodes
    donor_lowcount = [b for b, c in donor_counts_raw.items() if c < min_donor_count]
    donor_counts = {b: c for b, c in donor_counts_raw.items() if c >= min_donor_count}
    donor_barcodes = set(donor_counts.keys())

    rec_droplet_lowcount = [b for b, c in rec_droplet_counts_raw.items() if c < min_recipient_count]
    recipient_droplet_filtered = {b: c for b, c in rec_droplet_counts_raw.items() if b in donor_barcodes and c >= min_recipient_count}

    rec_plate_lowcount = [b for b, c in rec_plate_counts_raw.items() if c < min_recipient_count]
    recipient_plate_filtered = {b: c for b, c in rec_plate_counts_raw.items() if b in donor_barcodes and c >= min_recipient_count}

    # Summaries
    output_excel = os.path.join(data_folder, "donor_recipient_barcode_analysis.xlsx")
    df_export = pd.DataFrame({
        "Barcode": list(donor_barcodes),
        "Donor_Count": [donor_counts[b] for b in donor_barcodes],
        "Recipient_Droplet_Count": [recipient_droplet_filtered.get(b, 0) for b in donor_barcodes],
        "Recipient_Plate_Count": [recipient_plate_filtered.get(b, 0) for b in donor_barcodes]
    })
    df_export.to_excel(output_excel, index=False)

    # Compute R²
    r2_droplet = compute_r2(df_export["Donor_Count"], df_export["Recipient_Droplet_Count"])
    r2_plate = compute_r2(df_export["Donor_Count"], df_export["Recipient_Plate_Count"])

    # Store for summary
    summary_data.append({
        "Library": f"Library {i}",
        "Donor": len(donor_barcodes),
        "Droplet": len(recipient_droplet_filtered),
        "Plate": len(recipient_plate_filtered),
        "Donor Lowcount": len(donor_lowcount),
        "Droplet Lowcount": len(rec_droplet_lowcount),
        "Plate Lowcount": len(rec_plate_lowcount),
        "Donor Contam": len(donor_contam_reads),
        "Droplet Contam": len(droplet_contam_reads),
        "Plate Contam": len(plate_contam_reads),
        "R2 Droplet": r2_droplet,
        "R2 Plate": r2_plate
    })

# ================================
# COMBINED SUMMARY PLOT
# ================================
summary_df = pd.DataFrame(summary_data)
summary_df.to_excel(os.path.join(base_folder, "barcode_library_summary.xlsx"), index=False)
print("\n=== Summary ===")
print(summary_df)

# --- Bar Plot ---
methods = ["Donor", "Droplet", "Plate"]
x = range(len(library_folders))
bar_width = 0.25

fig, ax = plt.subplots(figsize=(8, 6))
for j, method in enumerate(methods):
    ax.bar([i + j * bar_width for i in x],
           summary_df[method],
           width=bar_width,
           label=method)

ax.set_xticks([i + bar_width for i in x])
ax.set_xticklabels(summary_df["Library"], fontsize=12)
ax.set_ylabel("Unique barcodes", fontsize=14)
ax.set_title("Library Barcode Recovery Across Methods", fontsize=16)
ax.legend(frameon=False, fontsize=12)

plt.tight_layout()
output_svg = os.path.join(base_folder, "combined_library_barplot.svg")
output_pdf = os.path.join(base_folder, "combined_library_barplot.pdf")
plt.savefig(output_svg)
plt.savefig(output_pdf)
plt.show()

print(f"\nCombined summary figure saved as:\n{output_svg}\n{output_pdf}")
